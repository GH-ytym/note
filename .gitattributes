# Normalize text files in the repository and keep source files on LF.
* text=auto eol=lf

# Keep Windows command scripts native when they are added in the future.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common assets as binary.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
