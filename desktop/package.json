{
  "name": "note-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Note 独立窗口桌面日历",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.cjs",
    "test": "node --test reminder-scheduler.test.cjs window-layout.test.cjs workspace-layout.test.cjs window-behavior.test.cjs",
    "start": "npm run prepare:app && electron .",
    "pack": "npm run prepare:app && electron-builder --dir --win --x64",
    "dist": "npm run prepare:app && electron-builder --win --x64",
    "dist:mac": "npm run prepare:app && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.note.calendar",
    "productName": "Note",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "reminder-scheduler.cjs",
      "window-layout.cjs",
      "workspace-layout.cjs",
      "workspace-mode.cjs",
      "build/window-icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "extraResources": [{ "from": "resources/note-api.exe", "to": "backend/note-api.exe" }],
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [{ "from": "resources/note-api", "to": "backend/note-api" }]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
